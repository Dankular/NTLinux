# Python bytecode cache - appears anywhere a .py file gets imported or
# py_compile'd (tooling/, driver/cell/launcher/qmp_console.py, ...).
__pycache__/

# Staged by distro/image/build.sh; should be cleaned up automatically but
# ignore it defensively in case a build is interrupted mid-way.
/distro/image/airootfs/root/ntloader-src/

# Compiled ntloader binary - build with `make -C ntloader`, don't commit it.
/ntloader/ntloader

# Phase 2 build artifacts - build with `make` in ntd/, ntabi/lib/, ntabi/tests/.
/ntd/ntd
/ntabi/lib/*.o
/ntabi/lib/*.a
/ntabi/lib/*.so
/ntabi/tests/test_ntabi

# Cross-compiled Windows binary - build with `make` in tooling/compat-db/ntexports/.
/tooling/compat-db/ntexports/ntexports.exe

# Phase 4 build artifacts and fetched/downloaded assets - never vendor these
# (ADR-0002/Rule 17: consume the upstream release, don't vendor it into the
# repo). Fetch with driver/cell/images/fetch-reactos-iso.sh; build the rest
# with `make` in driver/ntbridge/host/ and tests/reactos/, then
# tests/reactos/build-testguest-initramfs.sh.
/driver/cell/images/*.iso
/driver/cell/images/*.zip
/driver/cell/images/*.7z
/driver/ntbridge/host/ntbridge-host
/tests/reactos/ntbridge-guest-test
/tests/reactos/initramfs.cpio.gz
/tests/reactos/initramfs-root/

# Scratch download/build cache, not repo content.
/.build-cache/

# ntprobe: cross-compiled Windows binary and its output.
/tooling/compat-db/ntprobe/ntprobe.exe
/tooling/compat-db/ntprobe/*-results.json

# ntbridge.sys and Phase 5/7 drivers: cross-compiled Windows kernel binaries.
/driver/ntbridge/reactos/*.o
/driver/ntbridge/reactos/*.sys
/driver/vsdev/*.o
/driver/vsdev/*.sys
/driver/vsdev/vsdev_test.exe
/driver/net/reactos/*.o
/driver/net/reactos/*.sys
/driver/net/reactos/build/

# Real Microsoft WDK/SDK headers (driver/gpu/fetch-wdk-headers.sh) -
# their EULA explicitly prohibits redistribution, so these are fetched
# fresh, never committed (ADR-0002/Rule 17, same as every other fetched
# artifact above).
/driver/gpu/build/
/driver/gpu/wddm-probe.o

# parsec-vdd.h (driver/gpu/parsec-fallback/fetch-parsec-vdd-header.sh) -
# fetched fresh, never committed (same ADR-0002/Rule 17 shape as above);
# and the compiled Windows-host-only client (build-parsec-fallback.bat).
/driver/gpu/parsec-fallback/build/
/driver/gpu/parsec-fallback/ntlinux-parsec-fallback.exe
/driver/gpu/parsec-fallback/ntlinux-parsec-fallback.obj
/driver/usb/reactos/*.o
/driver/usb/reactos/*.sys
/driver/usb/reactos/ntusb_test.exe

# Real Microsoft KMDF headers (driver/kmdf/fetch-kmdf-headers.sh) - same
# WDK EULA/ADR-0002/Rule 17 shape as driver/gpu/build/ above.
/driver/kmdf/build/
/driver/kmdf/kmdf-probe.o

# Real Microsoft NDIS 6.x headers (driver/net/reactos/ndis6-probe/
# fetch-ndis6-headers.sh) - same WDK EULA/ADR-0002/Rule 17 shape as
# driver/gpu/build/ and driver/kmdf/build/ above.
/driver/net/reactos/ndis6-probe/build/
/driver/net/reactos/ndis6-probe/ndis6-probe.o
/driver/net/reactos/ndis6-probe/ndis6-probe.sys

# Phase 5: fetched ReactOS x64 nightly ISO - large, not vendored (consume,
# don't vendor - ADR-0002/Rule 17), same as the release ISOs above.
/driver/cell/images/reactos-livecd-*-x64-*.iso

# ntcell boot-reactos --screenshot output and QMP screendump intermediates
# (raw PPM before PNG conversion) land here during local runs - not
# committed. Curated, final evidence lives in driver/cell/screenshots/
# instead (same pattern as driver/vsdev/screenshots/).
/driver/cell/images/*.ppm
/driver/cell/images/*.png

# Phase 15: WireGuard profiles carry real account-tied private keys - never
# vendor a real one into the repo, defensively ignore any dropped next to
# the selector script during local testing.
/distro/network/wireguard-nearest/*.conf
