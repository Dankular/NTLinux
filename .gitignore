# Staged by distro/image/build.sh; should be cleaned up automatically but
# ignore it defensively in case a build is interrupted mid-way.
/distro/image/airootfs/root/ntloader-src/

# Compiled ntloader binary - build with `make -C ntloader`, don't commit it.
/ntloader/ntloader

# Phase 2 build artifacts - build with `make` in ntd/, ntabi/lib/, ntabi/tests/.
/ntd/ntd
/ntabi/lib/*.o
/ntabi/lib/*.a
/ntabi/tests/test_ntabi
