     SERVER_START_REQ( event_op )
     {
         req->handle = wine_server_obj_handle( handle );
@@ -2355,6 +2549,12 @@ NTSTATUS WINAPI NtWaitForSingleObject( HANDLE handle, BOOLEAN alertable, const L
         return ret;
     }
 
+    if (ntabi_try_wait_single( handle, alertable, timeout, &ret ))
