@@ -77,6 +77,194 @@ WINE_DEFAULT_DEBUG_CHANNEL(sync);
 HANDLE keyed_event = 0;
 int inproc_device_fd = -1;
 
+/* ---------------------------------------------------------------------
+ * NTLinux ntabi fast-sync integration (Event objects only) - real,
+ * scoped routing of NtCreateEvent/NtSetEvent/NtResetEvent/
+ * NtWaitForSingleObject through libntabi/ntd instead of wineserver,
+ * for the WINENTABI=1 opt-in case (default OFF - never changes
+ * unmodified Wine's behavior). See ROADMAP.md Phase 12 and
+ * wine/ntabi-sync-integration/README.md in the NTLinux repo for the
+ * full account, including what this deliberately does not cover
+ * (Mutant/Semaphore/Section/Completion/Process/Thread routing, and
+ * ntabi-side handle cleanup on NtClose - a real, documented, narrower
+ * slice, not the full Phase 2/3/12 breadth).
+ *
+ * Modeled directly on the *real*, already-upstream `inproc_*` fast-
+ * sync-path pattern immediately below (itself the ntsync kernel driver
+ * integration) - same "try the fast path, STATUS_NOT_IMPLEMENTED falls
+ * through to the normal wineserver call" shape, same "still create the
+ * real object via wineserver first, only fast-path the signal/wait
+ * traffic after" architecture (confirmed by reading inproc's own
+ * get_server_inproc_sync(), which itself calls wineserver once at
+ * setup time - this isn't a wineserver *replacement*, it's exactly the
+ * kind of after-creation fast path Phase 2's success criterion asks
+ * for: "some core NT operations no longer use the normal Wine
+ * (wineserver) path").
+ */
+#include <dlfcn.h>
+
+typedef struct ntabi_conn ntabi_conn_t;
+typedef int32_t ntabi_status_t;
+
+#define NTABI_STATUS_SUCCESS               0
+#define NTABI_STATUS_TIMEOUT               1
+
+static ntabi_conn_t *(*p_ntabi_connect)(void);
+static ntabi_status_t (*p_ntabi_create_event)(ntabi_conn_t *, const char *, int, int, int32_t *);
+static ntabi_status_t (*p_ntabi_set_event)(ntabi_conn_t *, int32_t);
+static ntabi_status_t (*p_ntabi_reset_event)(ntabi_conn_t *, int32_t);
+static ntabi_status_t (*p_ntabi_wait_single)(ntabi_conn_t *, int32_t, int32_t);
+
+static int ntabi_checked;
+static int ntabi_available;
+
+static void ntabi_init_once(void)
+{
+    void *dl;
+    if (ntabi_checked) return;
+    ntabi_checked = 1;
+    if (!getenv( "WINENTABI" )) return;
+    if (!(dl = dlopen( "libntabi.so", RTLD_NOW ))) return;
+    p_ntabi_connect      = dlsym( dl, "ntabi_connect" );
+    p_ntabi_create_event = dlsym( dl, "ntabi_create_event" );
+    p_ntabi_set_event    = dlsym( dl, "ntabi_set_event" );
+    p_ntabi_reset_event  = dlsym( dl, "ntabi_reset_event" );
+    p_ntabi_wait_single  = dlsym( dl, "ntabi_wait_single" );
+    if (!p_ntabi_connect || !p_ntabi_create_event || !p_ntabi_set_event ||
+        !p_ntabi_reset_event || !p_ntabi_wait_single)
+        return;
+    ntabi_available = 1;
+}
+
+static __thread ntabi_conn_t *ntabi_tls_conn;
+
+static ntabi_conn_t *ntabi_get_conn(void)
+{
+    ntabi_init_once();
+    if (!ntabi_available) return NULL;
+    if (!ntabi_tls_conn) ntabi_tls_conn = p_ntabi_connect();
+    return ntabi_tls_conn;
+}
+
+/* Real, minimal Wine-HANDLE -> ntabi-handle map: a fixed-size open-
+ * addressing table protected by one mutex. Scoped-proof-sized (4096
+ * entries), not meant to be the long-term data structure a full
+ * routing pass would use. */
+#define NTABI_EVENT_MAP_SIZE 4096
+struct ntabi_event_map_entry { HANDLE handle; int32_t ntabi_handle; };
+static struct ntabi_event_map_entry ntabi_event_map[NTABI_EVENT_MAP_SIZE];
+static pthread_mutex_t ntabi_event_map_lock = PTHREAD_MUTEX_INITIALIZER;
+
+static unsigned ntabi_map_hash( HANDLE handle )
+{
+    return ((UINT_PTR)handle >> 2) % NTABI_EVENT_MAP_SIZE;
+}
+
+static void ntabi_map_insert( HANDLE handle, int32_t ntabi_handle )
+{
+    unsigned i = ntabi_map_hash( handle );
+    pthread_mutex_lock( &ntabi_event_map_lock );
+    for (unsigned n = 0; n < NTABI_EVENT_MAP_SIZE; n++)
+    {
+        unsigned slot = (i + n) % NTABI_EVENT_MAP_SIZE;
+        if (!ntabi_event_map[slot].handle)
+        {
+            ntabi_event_map[slot].handle = handle;
+            ntabi_event_map[slot].ntabi_handle = ntabi_handle;
+            break;
+        }
+    }
+    pthread_mutex_unlock( &ntabi_event_map_lock );
+}
+
+/* Returns 0 (not found) or the ntabi handle + 1 (so 0 stays "empty
+ * slot" unambiguous even for a real ntabi handle value of 0). */
+static int32_t ntabi_map_lookup( HANDLE handle )
+{
+    unsigned i = ntabi_map_hash( handle );
+    int32_t result = 0;
+    pthread_mutex_lock( &ntabi_event_map_lock );
+    for (unsigned n = 0; n < NTABI_EVENT_MAP_SIZE; n++)
+    {
+        unsigned slot = (i + n) % NTABI_EVENT_MAP_SIZE;
+        if (!ntabi_event_map[slot].handle) break;
+        if (ntabi_event_map[slot].handle == handle)
+        {
+            result = ntabi_event_map[slot].ntabi_handle + 1;
+            break;
+        }
+    }
+    pthread_mutex_unlock( &ntabi_event_map_lock );
+    return result;
+}
+
+/* Called after a real wineserver NtCreateEvent succeeds - creates a
+ * matching ntabi event and remembers the mapping. Best-effort: if this
+ * fails for any reason, the wineserver-created event is still fully
+ * valid and correct, this thread's process just doesn't get the fast
+ * path for it (same fallback posture as inproc's own get_inproc_sync
+ * failure handling). */
+static void ntabi_register_event( HANDLE handle, BOOLEAN manual_reset, BOOLEAN initial_state )
+{
+    ntabi_conn_t *c;
+    int32_t out_handle;
+
+    if (!(c = ntabi_get_conn())) return;
+    if (p_ntabi_create_event( c, NULL, initial_state, manual_reset, &out_handle ) != NTABI_STATUS_SUCCESS)
+        return;
+    ntabi_map_insert( handle, out_handle );
+}
+
+/* Returns TRUE if handled (result in *ret), FALSE to fall through to
+ * the normal wineserver path unchanged. */
+static BOOL ntabi_try_set_event( HANDLE handle, unsigned int *ret )
+{
+    ntabi_conn_t *c;
+    int32_t mapped = ntabi_map_lookup( handle );
+    if (!mapped) return FALSE;
+    if (!(c = ntabi_get_conn())) return FALSE;
+    *ret = (p_ntabi_set_event( c, mapped - 1 ) == NTABI_STATUS_SUCCESS) ? STATUS_SUCCESS : STATUS_UNSUCCESSFUL;
+    return TRUE;
+}
+
+static BOOL ntabi_try_reset_event( HANDLE handle, unsigned int *ret )
+{
+    ntabi_conn_t *c;
+    int32_t mapped = ntabi_map_lookup( handle );
+    if (!mapped) return FALSE;
+    if (!(c = ntabi_get_conn())) return FALSE;
+    *ret = (p_ntabi_reset_event( c, mapped - 1 ) == NTABI_STATUS_SUCCESS) ? STATUS_SUCCESS : STATUS_UNSUCCESSFUL;
+    return TRUE;
+}
+
+/* NULL timeout = infinite. Only the common *relative* negative-100ns-
+ * unit form is handled (INFINITE and ordinary millisecond waits both
+ * take this shape from any normal caller); an absolute timeout falls
+ * through to the real wineserver path unchanged rather than being
+ * computed incorrectly - a real, deliberate scope limit, not a bug. */
+static BOOL ntabi_try_wait_single( HANDLE handle, BOOLEAN alertable, const LARGE_INTEGER *timeout, unsigned int *ret )
+{
+    ntabi_conn_t *c;
+    ntabi_status_t status;
+    int32_t timeout_ms;
+    int32_t mapped = ntabi_map_lookup( handle );
+
+    if (!mapped) return FALSE;
+    if (alertable) return FALSE;  /* APC delivery not part of this scoped slice */
+    if (!timeout) timeout_ms = -1;
+    else if (timeout->QuadPart < 0) timeout_ms = (int32_t)(-timeout->QuadPart / 10000);
+    else return FALSE;  /* absolute timeout - not handled here, fall through */
+
+    if (!(c = ntabi_get_conn())) return FALSE;
+    status = p_ntabi_wait_single( c, mapped - 1, timeout_ms );
+    if (status == NTABI_STATUS_SUCCESS) *ret = STATUS_SUCCESS;
+    else if (status == NTABI_STATUS_TIMEOUT) *ret = STATUS_TIMEOUT;
+    else return FALSE;  /* unexpected - fall through to wineserver rather than guess */
+    return TRUE;
+}
+/* --- end NTLinux ntabi fast-sync integration --- */
+
+
 static const char *debugstr_timeout( const LARGE_INTEGER *timeout )
 {
     if (!timeout) return "(infinite)";
